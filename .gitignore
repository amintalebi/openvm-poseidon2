**/target/

# Root Cargo.lock is committed for reproducible CI; nested (guest program) locks are not.
**/Cargo.lock
!./Cargo.lock

# Guest programs and generated init files
**/openvm/
**/openvm_init.rs

# These are backup files generated by rustfmt
**/*.rs.bk
**/.env
.DS_Store

.cache/
rustc-*

# This directory is used by RustRover (and any other JetBrains IDE)
.idea/

# IDE directories
.vscode/
.zed/

# Generated configs
.clangd
